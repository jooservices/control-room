# Jira site and dedicated read-only credentials.
JIRA_SITE=https://your-site.atlassian.net
JIRA_READ_ONLY_USER=read-only-user@example.com
JIRA_READ_ONLY_TOKEN=replace-with-read-only-token

# Comma-separated GitHub repositories in owner/repository form.
GITHUB_REPOS=jooservices/ai-flow,jooservices/control-room

# Jira project keys mapped to their GitHub repositories.
GITHUB_PROJECT_REPOS=JAIF=jooservices/ai-flow,JOOCR=jooservices/control-room

# Local snapshot and history directory.
DATA_DIR=./data

# Collection cadence in seconds (the design target is 30 to 60 seconds).
COLLECT_INTERVAL_SECONDS=45

# Web server bind address and port. Leave BIND_HOST empty to use the LAN address
# of this machine; the server never binds 0.0.0.0 unless you set it explicitly.
BIND_HOST=
PORT=8080
